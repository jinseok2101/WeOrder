generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nickname     String   @unique
  passwordHash String
  latitude     Float?
  longitude    Float?
  tossId       String?
  kakaoPayLink String?
  bankAccount  String?
  
  // 알림 여부 설정 (개별 온/오프 가능)
  notifyChat         Boolean @default(true)
  notifyRoomStatus   Boolean @default(true)
  notifySettlement   Boolean @default(true)
  
  // 신뢰 점수 및 리뷰 설정 (10점 만점)
  trustScore         Float   @default(10.0)
  reviewCount        Int     @default(0)
  
  createdAt    DateTime @default(now())

  hostedRooms       Room[]            @relation("RoomHost")
  memberships       RoomMember[]
  orderItems        OrderItem[]
  settlementShares  SettlementShare[]
  chatMessages      ChatMessage[]
  addresses         UserAddress[]
  pushSubscriptions PushSubscription[]
  reviewsGiven      UserReview[]      @relation("Reviewer")
  reviewsReceived   UserReview[]      @relation("Reviewee")
  notifications     Notification[]
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  roadAddress  String
  jibunAddress String?
  latitude     Float
  longitude    Float
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Room {
  id             String     @id @default(cuid())
  title          String
  restaurantName String
  restaurantUrl  String?
  status         RoomStatus @default(OPEN)
  hostId         String
  host           User       @relation("RoomHost", fields: [hostId], references: [id])
  deliveryFee    Int
  minimumOrder   Int
  radiusKm       Float      @default(1.0)
  pickupLocation String?
  dongName       String?
  latitude       Float
  longitude      Float
  deadline       DateTime
  createdAt      DateTime   @default(now())

  members      RoomMember[]
  orderItems   OrderItem[]
  settlement   Settlement?
  chatMessages ChatMessage[]
  reviews      UserReview[]
}

enum RoomStatus {
  OPEN
  ORDERING
  ORDERED
  SETTLED
  CANCELLED
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  price     Int
  quantity  Int      @default(1)
  options   String?
  createdAt DateTime @default(now())
}

model Settlement {
  id          String           @id @default(cuid())
  roomId      String           @unique
  room        Room             @relation(fields: [roomId], references: [id])
  totalAmount Int
  deliveryFee Int
  status      SettlementStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  shares SettlementShare[]
}

enum SettlementStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model SettlementShare {
  id            String      @id @default(cuid())
  settlementId  String
  settlement    Settlement  @relation(fields: [settlementId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  menuAmount    Int
  deliverySplit Int
  totalAmount   Int
  status        ShareStatus @default(PENDING)
  paidAt        DateTime?

  @@unique([settlementId, userId])
}

enum ShareStatus {
  PENDING
  REQUESTED
  PAID
  CONFIRMED
}

model ChatMessage {
  id        String      @id @default(cuid())
  roomId    String
  room      Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  content   String
  type      MessageType @default(USER)
  createdAt DateTime    @default(now())
}

enum MessageType {
  USER
  SYSTEM
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "WEB" (VAPID) 또는 "APP" (Expo)
  endpoint  String   @unique // Web Push의 수신 URL 또는 Expo Push Token
  p256dh    String?  // Web Push 암호화용 퍼블릭 키 (WEB 전용)
  auth      String?  // Web Push 암호화용 인증 키 (WEB 전용)
  createdAt DateTime @default(now())
}

model UserReview {
  id          String   @id @default(cuid())
  reviewerId  String
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  rating      Float    // 0.5 ~ 5.0 (0.5 단위)
  tags        String[] // 선택된 평가 태그 목록
  comment     String?  // 한줄평 (선택)
  createdAt   DateTime @default(now())

  @@unique([roomId, reviewerId, revieweeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   // "CHAT", "ROOM_STATUS", "SETTLEMENT"
  targetId  String?  // 연관된 Room ID 등
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
